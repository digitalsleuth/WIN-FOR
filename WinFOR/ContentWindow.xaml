<Window x:Class="WinFOR.ContentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Cell Content" Width="700" Height="380" MinWidth="360" MinHeight="180"
        ShowInTaskbar="False" ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="CenterOwner" SnapsToDevicePixels="True" UseLayoutRounding="True"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="3"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Border x:Name="LevelStrip" Grid.Row="0" Background="Transparent"/>
        <TextBox x:Name="ContentBox" Grid.Row="1" IsReadOnly="True" IsReadOnlyCaretVisible="True" AcceptsReturn="True"
                 FontFamily="Consolas" FontSize="12" Padding="12,8" BorderThickness="0"
                 TextWrapping="Wrap" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"/>
        <Border Grid.Row="2" Background="#FFF3F3F3" BorderBrush="#FFD8D8D8" BorderThickness="0,1,0,0" Padding="12,8">
            <DockPanel LastChildFill="False">
                <TextBlock x:Name="InfoText" DockPanel.Dock="Left" VerticalAlignment="Center" Foreground="#FF5F5F5F" FontSize="12"/>
                <CheckBox x:Name="WrapCheck" DockPanel.Dock="Left" Margin="16,0,0,0" VerticalAlignment="Center" VerticalContentAlignment="Center" FontSize="12" Content="Wrap lines" IsChecked="True" Checked="WrapChanged" Unchecked="WrapChanged"/>
                <Button x:Name="CloseButton" DockPanel.Dock="Right" Content="Close" Width="75" Height="24" FontSize="12" Background="White" Click="Close_Click"/>
                <Button x:Name="CopyButton" DockPanel.Dock="Right" Content="Copy" Width="75" Height="24" Margin="0,0,8,0" FontSize="12" Background="White" ToolTip="Copy all of the text" Click="Copy_Click"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
