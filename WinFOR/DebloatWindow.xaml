<Window x:Class="WinFOR.DebloatWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WinFOR"
        mc:Ignorable="d"
        WindowStartupLocation="CenterScreen" SnapsToDevicePixels="True" UseLayoutRounding="True"
        Title="Debloat Options" Width="780" Height="660" MinWidth="680" MinHeight="420" Background="White"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid Grid.Row="0" Margin="14,10,14,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="SearchBox" Grid.Column="0" Height="26" FontSize="12" VerticalContentAlignment="Center" local:Placeholder.Text="Search all options" TextChanged="SearchBox_TextChanged" ToolTip="Search every category (Ctrl+F)"/>
            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <Button x:Name="DefaultOptionsButton" Width="90" Height="26" FontSize="12" Content="Show Default" Click="DefaultButton_Click" Background="White" ToolTip="Select the recommended default options"/>
                <Button x:Name="ResetAllButton" Width="70" Height="26" FontSize="12" Content="Reset" Margin="8,0,0,0" Click="ResetButton_Click" Background="White" ToolTip="Clear every selection"/>
            </StackPanel>
        </Grid>
        <Border Grid.Row="1" Margin="14,10,14,0" Padding="10,6" Background="#FFFFF4CE" BorderBrush="#FFE8D58A" BorderThickness="1" CornerRadius="4">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="#FF7A5C00" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBlock Text="These options debloat your Windows setup during the installation process. Use at your own risk." FontSize="12" Foreground="#FF5C4A00" VerticalAlignment="Center" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>
        <Grid Grid.Row="2" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="190"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <ListBox x:Name="CategoryList" Grid.Column="0" Margin="10,0,6,0" BorderThickness="0" Background="Transparent" ItemContainerStyle="{StaticResource CategoryItem}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionChanged="CategoryList_SelectionChanged"/>
            <Border Grid.Column="0" Width="1" HorizontalAlignment="Right" Background="{StaticResource DividerBrush}"/>
            <ScrollViewer x:Name="OptionsScroll" Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,0,0,0">
                <Grid>
                    <StackPanel x:Name="OptionsHost" Margin="16,0,16,8"/>
                    <TextBlock x:Name="NoResultsText" Text="No options match your search." Foreground="Gray" FontSize="12" Margin="16,12,0,0" Visibility="Collapsed"/>
                </Grid>
            </ScrollViewer>
        </Grid>
        <Border Grid.Row="3" Background="#FFF6F6F6" BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,1,0,0" Padding="14,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="SummaryText" Grid.Column="0" FontSize="12" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button x:Name="SaveAsFileButton" Width="90" Height="26" FontSize="12" Content="Save As File" Click="SaveAsFileButton_Click" Background="White" ToolTip="Save the selections as a .preset file"/>
                    <Button x:Name="SaveSettingsButton" Width="100" Height="26" FontSize="12" Content="Save Settings" Margin="8,0,0,0" Click="GetRadioButtonsStatus_Click" Background="White" ToolTip="Use these selections for the debloat during installation"/>
                    <Button x:Name="DebloatButton" Width="100" Height="26" Content="Debloat Now" Margin="8,0,0,0" Click="DebloatButton_Click" Style="{StaticResource PrimaryButton}" ToolTip="Apply the selected options to this system now"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
