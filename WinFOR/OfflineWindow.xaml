<Window x:Class="WinFOR.OfflineWindow"
        x:Name="offlineWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WinFOR"
        mc:Ignorable="d"
        Title="Install Offline" Width="400" SizeToContent="Height" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" SnapsToDevicePixels="True" UseLayoutRounding="True"
        FocusManager.FocusedElement="{Binding ElementName=DownloadsPath}">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Style="{StaticResource Card}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Text="Offline install" Style="{StaticResource CardTitle}"/>
                <Label x:Name="DownloadsLabel" Grid.Row="1" Grid.ColumnSpan="2" Target="{Binding ElementName=DownloadsPath}" Content="Downloads path:" Padding="0,0,0,2" FontSize="12"/>
                <TextBox x:Name="DownloadsPath" Grid.Row="2" Grid.Column="0" Height="24" FontSize="12" VerticalContentAlignment="Center" Margin="0,0,0,8"/>
                <Button x:Name="DownloadsPickerBtn" Grid.Row="2" Grid.Column="1" Style="{StaticResource IconButton}" Content="&#xED25;" Height="24" Margin="4,0,0,8" IsTabStop="False" Click="DownloadsPicker" ToolTip="Browse for a folder"/>
                <Label x:Name="StandalonesLabel" Grid.Row="3" Grid.ColumnSpan="2" Target="{Binding ElementName=StandalonesPath}" Content="Standalones path:" Padding="0,0,0,2" FontSize="12"/>
                <TextBox x:Name="StandalonesPath" Grid.Row="4" Grid.Column="0" Height="24" FontSize="12" VerticalContentAlignment="Center" Margin="0,0,0,8"/>
                <Button x:Name="StandalonesPickerBtn" Grid.Row="4" Grid.Column="1" Style="{StaticResource IconButton}" Content="&#xED25;" Height="24" Margin="4,0,0,8" IsTabStop="False" Click="StandalonesPicker" ToolTip="Browse for a folder"/>
                <Label x:Name="UserNameLabel" Grid.Row="5" Grid.ColumnSpan="2" Target="{Binding ElementName=UserName}" Content="Username:" Padding="0,0,0,2" FontSize="12" ToolTip="Enter the username for whom to install and customize the environment.&#x0a;If the user does not exist, it will be created"/>
                <TextBox x:Name="UserName" Grid.Row="6" Grid.ColumnSpan="2" Height="24" FontSize="12" VerticalContentAlignment="Center" ToolTip="Enter the username for whom to install and customize the environment.&#x0a;If the user does not exist, it will be created"/>
            </Grid>
        </Border>
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button x:Name="InstallButton" Content="Install" Width="90" Height="28" Style="{StaticResource PrimaryButton}" IsDefault="True" Click="InstallClick" ToolTip="Will install the chosen tools / environment"/>
            <Button x:Name="CancelButton" Content="Cancel" Width="90" Height="28" FontSize="12" Margin="8,0,0,0" Background="White" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
