<Window x:Class="WinFOR.ResultsWindow"
        x:Name="resultWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WinFOR"
        mc:Ignorable="d"
        Title="SaltStack Results" Width="1060" Height="680" MinWidth="780" MinHeight="420" Background="White"
        WindowStartupLocation="CenterOwner" SnapsToDevicePixels="True" UseLayoutRounding="True"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <Style TargetType="ListViewItem">
            <Setter Property="VerticalContentAlignment" Value="Top"/>
        </Style>
        <Style x:Key="LogFileItem" TargetType="ListBoxItem" BasedOn="{StaticResource CategoryItem}">
            <EventSetter Event="PreviewMouseRightButtonDown" Handler="LogItem_RightClick"/>
        </Style>
        <DataTemplate x:Key="HeaderTemplateArrowUp">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding}"/>
                <Path Fill="Gray" Data="M 0,4 L 8,4 L 4,0 Z" Margin="6,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
        </DataTemplate>
        <DataTemplate x:Key="HeaderTemplateArrowDown">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding}"/>
                <Path Fill="Gray" Data="M 0,0 L 8,0 L 4,4 Z" Margin="6,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
        </DataTemplate>
        <DataTemplate DataType="{x:Type local:LogFileInfo}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding KindLabel}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Modified, StringFormat='yyyy-MM-dd HH:mm'}" FontSize="11" Foreground="{StaticResource MutedTextBrush}" Margin="8,0,0,0"/>
                <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding Detail}" FontSize="11" Foreground="{StaticResource MutedTextBrush}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Path}"/>
                <TextBlock Grid.Row="2" Grid.ColumnSpan="2" Text="{Binding Summary}" Foreground="{Binding SummaryBrush}" FontSize="11" Margin="0,1,0,0" TextTrimming="CharacterEllipsis"/>
            </Grid>
        </DataTemplate>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid Grid.Column="0" Margin="14,10,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" Margin="0,0,10,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Log files" Style="{StaticResource CardTitle}" Margin="0" VerticalAlignment="Center"/>
                    <Button x:Name="RefreshButton" Grid.Column="1" Style="{StaticResource IconButton}" Content="&#xE72C;" Click="Refresh_Click" ToolTip="Scan for log files again (F5)"/>
                </Grid>
                <ListBox x:Name="LogList" Grid.Row="1" Margin="0,0,6,10" BorderThickness="0" Background="Transparent" SelectionMode="Extended" ItemContainerStyle="{StaticResource LogFileItem}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionChanged="LogList_SelectionChanged">
                    <ListBox.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.HeaderTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="4,10,0,3">
                                        <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}"/>
                                        <TextBlock Text="{Binding ItemCount, StringFormat=' · {0}'}" FontSize="11" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Bottom"/>
                                    </StackPanel>
                                </DataTemplate>
                            </GroupStyle.HeaderTemplate>
                        </GroupStyle>
                    </ListBox.GroupStyle>
                    <ListBox.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Open Log File" Click="OpenLogFile_Click"/>
                            <MenuItem Header="Show in Folder" Click="ShowInFolder_Click"/>
                            <MenuItem Header="Copy Path" Click="CopyPath_Click"/>
                            <Separator/>
                            <MenuItem Header="Refresh" Click="Refresh_Click" InputGestureText="F5"/>
                        </ContextMenu>
                    </ListBox.ContextMenu>
                </ListBox>
                <TextBlock x:Name="NoLogsText" Grid.Row="1" Text="No log files were found." Foreground="Gray" FontSize="12" Margin="4,10,0,0" Visibility="Collapsed"/>
                <Border Grid.Row="0" Grid.RowSpan="2" Width="1" HorizontalAlignment="Right" Background="{StaticResource DividerBrush}"/>
            </Grid>
            <Grid Grid.Column="1" Margin="0,10,14,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" Margin="10,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <ComboBox x:Name="LogLevelComboBox" Grid.Column="0" Height="26" FontSize="12" SelectedIndex="0" SelectionChanged="LogLevelComboBox_SelectionChanged" ToolTip="Show only entries of this level">
                        <ComboBoxItem Content="All levels"/>
                        <ComboBoxItem Content="INFO"/>
                        <ComboBoxItem Content="DEBUG"/>
                        <ComboBoxItem Content="WARNING"/>
                        <ComboBoxItem Content="ERROR"/>
                        <ComboBoxItem Content="CRITICAL"/>
                    </ComboBox>
                    <TextBox x:Name="DateFilterBox" Grid.Column="2" Height="26" FontSize="12" VerticalContentAlignment="Center" local:Placeholder.Text="Filter by date" TextChanged="FilterBox_TextChanged"/>
                    <TextBox x:Name="ResultFilterBox" Grid.Column="4" Height="26" FontSize="12" VerticalContentAlignment="Center" local:Placeholder.Text="Filter results (Ctrl+F)" TextChanged="FilterBox_TextChanged"/>
                    <StackPanel Grid.Column="6" Orientation="Horizontal">
                        <Button x:Name="ClearFilters_Button" Width="90" Height="26" FontSize="12" Content="Clear Filters" Click="ClearFilters_Click" Background="White"/>
                        <Button x:Name="ResetView_Button" Width="80" Height="26" FontSize="12" Content="Reset View" Margin="8,0,0,0" Click="ResetView_Click" Background="White" ToolTip="Clear the sort order and column widths"/>
                    </StackPanel>
                </Grid>
                <ListView x:Name="LogListView" Grid.Row="1" Margin="10,0,0,10" VirtualizingPanel.VirtualizationMode="Recycling" SizeChanged="LogListView_SizeChanged" GridViewColumnHeader.Click="GridViewColumnHeader_Clicked" SelectionMode="Extended" PreviewKeyDown="LogListView_KeyboardCopy" MouseDoubleClick="Cell_MouseDoubleClick" PreviewMouseDoubleClick="Header_PreviewMouseDoubleClick">
                    <ListView.View>
                        <GridView AllowsColumnReorder="False" x:Name="ResultsGridView">
                            <GridViewColumn Header="Release" DisplayMemberBinding="{Binding Release}" Width="0" x:Name="ReleaseColumn"/>
                            <GridViewColumn Header="Log" DisplayMemberBinding="{Binding Source}" Width="0" x:Name="SourceColumn"/>
                            <GridViewColumn Header="Date" DisplayMemberBinding="{Binding Date}" Width="150" x:Name="DateColumn"/>
                            <GridViewColumn Header="Level" DisplayMemberBinding="{Binding Level}" Width="80" x:Name="LevelColumn"/>
                            <GridViewColumn Header="Result" DisplayMemberBinding="{Binding Result}" Width="440" x:Name="ResultColumn"/>
                        </GridView>
                    </ListView.View>
                    <ListView.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Copy" Click="ContextMenuItem_CopyClick" InputGestureText="Ctrl+C"/>
                        </ContextMenu>
                    </ListView.ContextMenu>
                </ListView>
                <TextBlock x:Name="NoEntriesText" Grid.Row="1" Text="Select one or more log files to see their entries." Foreground="Gray" FontSize="12" Margin="22,40,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" IsHitTestVisible="False"/>
            </Grid>
        </Grid>
        <Border Grid.Row="1" Background="#FFF6F6F6" BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,1,0,0" Padding="14,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="SummaryText" Grid.Column="0" FontSize="12" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button x:Name="OpenLogButton" Width="110" Height="26" FontSize="12" Content="Open Log File" Click="OpenLogFile_Click" Background="White" ToolTip="Open the selected log files in the default editor"/>
                    <Button x:Name="ShowFolderButton" Width="110" Height="26" FontSize="12" Content="Show in Folder" Margin="8,0,0,0" Click="ShowInFolder_Click" Background="White" ToolTip="Show the selected log files in File Explorer"/>
                    <Button x:Name="CloseButton" Width="80" Height="26" Content="Close" Margin="8,0,0,0" Click="Close_Click" Style="{StaticResource PrimaryButton}" IsCancel="True"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
